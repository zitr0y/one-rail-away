{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite-dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/web" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "." },
        "background": { "activeOnStart": true, "beginsPattern": ".", "endsPattern": "Local:" }
      }
    }
  ]
}
